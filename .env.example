# ---- Shared ----
NODE_ENV=development

# ---- API (apps/api) ----
API_PORT=4000
DATABASE_URL=postgresql://aucn:aucn@localhost:5432/aucnhub?schema=public
# Comma separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
# Access/refresh token signing secrets (>=32 chars; rotate via secret manager in prod)
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
JWT_REFRESH_SECRET=change-me-too-change-me-too-change-me-too
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# log | smtp  (log prints OTP codes to the API log; never use in production)
OTP_DELIVERY=log
OTP_TTL_SECONDS=600

# ---- Reserved for later increments (leave empty) ----
REDIS_URL=
OPENSEARCH_URL=
S3_BUCKET=
S3_REGION=ap-southeast-2
WECHAT_WEB_APP_ID=
WECHAT_WEB_APP_SECRET=
WECHAT_MOBILE_APP_ID=
WECHAT_MOBILE_APP_SECRET=
APPLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOOGLE_MAPS_API_KEY=
SMTP_URL=
SENTRY_DSN=
KMS_KEY_ALIAS=

# ---- Web (apps/web) ----
NEXT_PUBLIC_API_URL=http://localhost:4000
# Server-side URL the Next.js server uses to reach the API (same as above in local dev)
API_INTERNAL_URL=http://localhost:4000

# ---- Increment 1 integrations (only configured providers are offered) ----
API_PUBLIC_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
# Local image storage; mount a persistent volume in production, or configure S3_BUCKET
MEDIA_LOCAL_DIR=./uploads
SMTP_FROM=
GOOGLE_CLIENT_SECRET=
# Signed Apple client-secret JWT; rotate before expiry
APPLE_CLIENT_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# One-time AUD Stripe Price for a 7-day listing highlight
STRIPE_PROMOTION_PRICE_ID=
# WebAuthn/passkey: relying-party domain + display name + allowed origins (CORS_ORIGINS is used)
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=AUCN Hub
# Web Push (VAPID); generate with `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Public VAPID key exposed to the browser for pushManager.subscribe
NEXT_PUBLIC_VAPID_KEY=
# Twilio SMS delivery for out-of-app notifications (Verify SID is OTP-only)
TWILIO_FROM_NUMBER=
# Optional external image scanner endpoint ({contentBase64,mime} -> {verdict}) and known-bad sha256 list
IMAGE_SCAN_URL=
IMAGE_SCAN_BLOCKLIST=
# OpenTelemetry export (off unless OTEL_ENABLED=true)
OTEL_ENABLED=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Weekend event collector (curated events review pipeline).
# Imported RSS leads stay pending until an editor adds dates/venue/summary.
# format: rss | json ; category: general | family | social | market | festival
# Audience is Chinese-speaking; configure Chinese-language sources only.
# Example:
# WEEKEND_SOURCES_JSON=[
#   {"id":"oursteps-social","name":"新足迹·聚会交友","url":"https://www.oursteps.com.au/bbs/forum.php?mod=rss&fid=119","format":"rss","cityId":null,"category":"social","enabled":true,"intervalMinutes":30}
# ]
WEEKEND_COLLECTOR_ENABLED=
WEEKEND_SOURCES_JSON=[]

# Pulse content pipeline: daily metrics + auto-collected news/deals/guides/notices.
# Sources are upserted on boot; ids not in the list get disabled.
# format: rss | json | frankfurter | openmeteo | fuelcheck
# category: news | deal | event | guide | notice | housing | job | market | service | metric
# Textual sources must be Chinese-language; metric adapters (rates/weather) produce numbers only.
# 'event' items power the auto-updating intel block on the weekend page.
# autoPublish only takes effect when the item passes the risk screen.
# Example:
# PULSE_SOURCES_JSON=[
#   {"id":"frankfurter-aud","name":"ECB reference rates","url":"https://api.frankfurter.dev/v1/latest?base=AUD&symbols=CNY","format":"frankfurter","category":"metric","autoPublish":true,"enabled":true,"intervalMinutes":360},
#   {"id":"openmeteo-sydney","name":"Open-Meteo Sydney","url":"https://api.open-meteo.com/v1/forecast?latitude=-33.8688&longitude=151.2093&current=temperature_2m,apparent_temperature,weather_code,wind_speed_10m,relative_humidity_2m&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max,uv_index_max&timezone=Australia%2FSydney","format":"openmeteo","category":"metric","autoPublish":true,"enabled":true,"intervalMinutes":60},
#   {"id":"oursteps-news","name":"新足迹·新闻汇总","url":"https://www.oursteps.com.au/bbs/forum.php?mod=rss&fid=43","format":"rss","category":"news","autoPublish":true,"enabled":true,"intervalMinutes":30},
#   {"id":"oursteps-rent","name":"新足迹·房屋租赁","url":"https://www.oursteps.com.au/bbs/forum.php?mod=rss&fid=95","format":"rss","category":"housing","autoPublish":true,"enabled":true,"intervalMinutes":30},
#   {"id":"oursteps-jobs","name":"新足迹·招工找工","url":"https://www.oursteps.com.au/bbs/forum.php?mod=rss&fid=42","format":"rss","category":"job","autoPublish":true,"enabled":true,"intervalMinutes":30}
# ]
PULSE_COLLECTOR_ENABLED=
PULSE_SOURCES_JSON=[]

# Feed item translation (en→zh on import, best effort).
# DeepL Free API key preferred; falls back to the public MyMemory endpoint.
DEEPL_API_KEY=
# Optional email raises the MyMemory anonymous quota.
MYMEMORY_EMAIL=
