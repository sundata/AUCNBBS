  "privacy": {
    "title": "Privacy policy",
    "updated": "Last updated: 13 Sep 2026",
    "intro": "This policy explains how AUCN Hub collects, uses and protects your personal information.",
    "sections": {
      "collect": {
        "title": "What we collect",
        "body": "Account data (email or third-party sign-in identifier, display name, city, avatar); content you publish (posts, classifieds, reviews, events, direct messages); usage data (views, searches, signed-in devices). Payments are processed by Stripe — we never store card numbers."
      },
      "use": {
        "title": "How we use it",
        "body": "To provide sign-in, publishing, messaging, moderation and safety, paid benefits, and to meet legal obligations. We do not sell personal information or message content."
      },
      "share": {
        "title": "Sharing",
        "body": "Content you publish publicly is visible to visitors; direct messages are only visible to the participants; payment details are shared only with Stripe; disclosures may be made where the law requires."
      },
      "storage": {
        "title": "Storage & security",
        "body": "Data is stored on databases in Australia; transport uses TLS; secrets and tokens are stored as hashes. We retain operational and safety data for a reasonable period."
      },
      "rights": {
        "title": "Your rights",
        "body": "Under Me you can export your data, manage signed-in devices and request account deletion (cancelable during the 7-day cooling-off period). Contact us to correct or delete information."
      },
      "cookies": {
        "title": "Cookies",
        "body": "This site uses only the minimal cookies/local storage needed for sessions and preferences — no third-party advertising trackers."
      },
      "contact": {
        "title": "Contact us",
        "body": "For privacy questions, reach us through the support channels on the contact page."
      }
    }
  },
  "terms": {
    "title": "Terms of use",
    "updated": "Last updated: 13 Sep 2026",
    "sections": {
      "acceptance": {
        "title": "Acceptance",
        "body": "By using this platform you accept these terms and the community guidelines. The platform serves local life in Australia; content is published by users."
      },
      "accounts": {
        "title": "Accounts",
        "body": "You are responsible for activity under your account. False information, impersonation or bypassing security measures can lead to restrictions."
      },
      "content": {
        "title": "Your content",
        "body": "You keep the rights to what you publish and grant us the licence needed to display it. You must ensure it is truthful, lawful and does not infringe others' rights."
      },
      "prohibited": {
        "title": "Prohibited conduct",
        "body": "No scams, discrimination, harassment, illegal goods, privacy violations, spam or dangerous or misleading content. Housing and job ads must comply with Australian law."
      },
      "moderation": {
        "title": "Moderation",
        "body": "We may review, remove or restrict content and accounts. You can appeal a decision — a different moderator reviews appeals."
      },
      "paid": {
        "title": "Paid services",
        "body": "Paid services such as promotions are billed via Stripe; prices are shown on the page and refunds follow the stated policy. Payment never changes moderation standards."
      },
      "liability": {
        "title": "Liability",
        "body": "We are not a party to transactions between users, do not hold funds and do not guarantee the accuracy of user content. Verify details yourself and stay safe when meeting."
      },
      "changes": {
        "title": "Changes",
        "body": "Updates to these terms are published on this page; continued use means acceptance of the new version."
      }
    }
